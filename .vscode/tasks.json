{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "volley-server",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/server/dev-server.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "volley",
        "pattern": { "regexp": "^ERROR (.*):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^VOLLEY_STARTING$",
          "endsPattern": "^VOLLEY_READY$"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
